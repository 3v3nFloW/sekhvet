/// String that uniquely identifies the bundle
PRODUCT_BUNDLE_IDENTIFIER_PREFIX = vet.kappa1.sekhvet

/// Current version of the project
CURRENT_PROJECT_VERSION = 174

/// User-visible version of the project
MARKETING_VERSION = 1.0

/// Copyright notice for the bundle
HUMAN_READABLE_VERSION = SekhVet 1.0

/// Copyright notice for the bundle
HUMAN_READABLE_COPYRIGHT = © 2026 Kappa1-VRS GmbH. Based on Horos © The Horos Project and OsiriX © OsiriX Team / Pixmeo SARL

/// SekhVet Paket BN: keep the build machine path out of __FILE__ strings
OTHER_CFLAGS = $(inherited) -ffile-prefix-map=$(SRCROOT)=.
